scoreboard players operation @s fg.need = @s fg.loaded
execute if score @s fg.need matches 1.. run scoreboard players remove @s fg.need 1
scoreboard players operation @s fg.math = @s fg.next
scoreboard players operation @s fg.math -= @s fg.now
execute if score @s fg.reload matches 0 if score @s fg.math matches 1.. run title @s actionbar [{text:'上膛中 ',color:'yellow'},{score:{name:'@s',objective:'fg.math'},color:'white'},{text:'t | ',color:'gray'},{nbt:'held.ammo.label',storage:'firearms:runtime',interpret:false,color:'gold'},{text:' | 枪内 ',color:'gray'},{score:{name:'@s',objective:'fg.loaded'},color:'white'},{text:' | 背包 ',color:'gray'},{score:{name:'@s',objective:'fg.reserve'},color:'yellow'}]
execute if score @s fg.reload matches 0 if score @s fg.math matches ..0 if score @s fg.loaded matches 1.. run title @s actionbar [{nbt:'held.ammo.label',storage:'firearms:runtime',interpret:false,color:'gold'},{text:' | 膛内 1 + 枪内备弹 ',color:'gray'},{score:{name:'@s',objective:'fg.need'},color:'white'},{text:' | 背包 ',color:'gray'},{score:{name:'@s',objective:'fg.reserve'},color:'yellow'}]
execute if score @s fg.reload matches 0 if score @s fg.math matches ..0 if score @s fg.loaded matches ..0 run title @s actionbar [{nbt:'held.ammo.label',storage:'firearms:runtime',interpret:false,color:'gold'},{text:' | 膛内 0 + 枪内备弹 0',color:'red'},{text:' | 背包 ',color:'gray'},{score:{name:'@s',objective:'fg.reserve'},color:'yellow'}]
execute if score @s fg.reload matches 1.. if score @s fg.rphase matches 1 run title @s actionbar [{text:'打开装填口 ',color:'green'},{score:{name:'@s',objective:'fg.reload'},color:'white'},{text:'t | ',color:'gray'},{nbt:'held.ammo.label',storage:'firearms:runtime',interpret:false,color:'gold'},{text:' | 枪内 ',color:'gray'},{score:{name:'@s',objective:'fg.loaded'},color:'white'},{text:'/3 | 背包 ',color:'gray'},{score:{name:'@s',objective:'fg.reserve'},color:'yellow'}]
execute if score @s fg.reload matches 1.. if score @s fg.rphase matches 2 run title @s actionbar [{text:'装填下一发 ',color:'green'},{score:{name:'@s',objective:'fg.reload'},color:'white'},{text:'t | ',color:'gray'},{nbt:'held.ammo.label',storage:'firearms:runtime',interpret:false,color:'gold'},{text:' | 枪内 ',color:'gray'},{score:{name:'@s',objective:'fg.loaded'},color:'white'},{text:'/3 | 背包 ',color:'gray'},{score:{name:'@s',objective:'fg.reserve'},color:'yellow'}]
execute if score @s fg.reload matches 1.. if score @s fg.rphase matches 3 run title @s actionbar [{text:'关闭装填口 ',color:'green'},{score:{name:'@s',objective:'fg.reload'},color:'white'},{text:'t | ',color:'gray'},{nbt:'held.ammo.label',storage:'firearms:runtime',interpret:false,color:'gold'},{text:' | 枪内 ',color:'gray'},{score:{name:'@s',objective:'fg.loaded'},color:'white'},{text:'/3 | 背包 ',color:'gray'},{score:{name:'@s',objective:'fg.reserve'},color:'yellow'}]

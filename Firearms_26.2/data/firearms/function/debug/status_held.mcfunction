function firearms:state/load_held
execute store result score @s fg.serial run data get storage firearms:runtime held.serial 1
function firearms:stats/calculate
function firearms:ammo/count
tellraw @s [{text:'[Firearms] serial=',color:'aqua'},{score:{name:'@s',objective:'fg.serial'}},{text:' ammo='},{score:{name:'@s',objective:'fg.loaded'}},{text:'/'},{score:{name:'@s',objective:'fg.mag'}},{text:' available='},{score:{name:'@s',objective:'fg.reserve'}}]
execute if data storage firearms:runtime {held:{ammo:{type:'pistol'}}} run tellraw @s {text:'ammo_type=pistol (inventory)',color:'gray'}
execute if data storage firearms:runtime {held:{ammo:{type:'rifle'}}} run tellraw @s {text:'ammo_type=rifle (inventory)',color:'gray'}
execute if data storage firearms:runtime {held:{ammo:{type:'shotgun'}}} run tellraw @s {text:'ammo_type=shotgun (inventory)',color:'gray'}
execute if data storage firearms:runtime {held:{ammo:{type:'sniper'}}} run tellraw @s {text:'ammo_type=sniper (inventory)',color:'gray'}
execute if data storage firearms:runtime {held:{ammo:{type:'magnum'}}} run tellraw @s {text:'ammo_type=magnum (inventory)',color:'gray'}
execute if data storage firearms:runtime {held:{ammo:{type:'grenade_he'}}} run tellraw @s {text:'ammo_type=grenade_he (inventory); chamber+internal total is ammo',color:'red'}
execute if data storage firearms:runtime {held:{ammo:{type:'grenade_incendiary'}}} run tellraw @s {text:'ammo_type=grenade_incendiary (inventory); chamber+internal total is ammo',color:'gold'}
execute if data storage firearms:runtime {held:{ammo:{type:'grenade_bioweapon'}}} run tellraw @s {text:'ammo_type=grenade_bioweapon (inventory); chamber+internal total is ammo',color:'dark_green'}
execute if data storage firearms:runtime {held:{ammo:{type:'infinite_rocket'}}} run tellraw @s {text:'ammo_type=infinite_rocket (no inventory item)',color:'light_purple'}
execute if data storage firearms:runtime {held:{gun:{id:'gl3_launcher'}}} run tellraw @s [{text:'launcher: projectile speed=0.85 + vertical 0.12; chamber ready at game_tick '},{score:{name:'@s',objective:'fg.next'}},{text:'; reload open/round/close='},{score:{name:'@s',objective:'fg.ropen'}},{text:'/'},{score:{name:'@s',objective:'fg.rticks'}},{text:'/'},{score:{name:'@s',objective:'fg.rclose'}}]
execute if data storage firearms:runtime {held:{gun:{id:'rpg_launcher'}}} run tellraw @s [{text:'rocket: speed=1.40, max_range=96, max_life=80t, direct=160, blast=80/40/20, reload='},{score:{name:'@s',objective:'fg.rticks'}},{text:'t'}]
execute unless data storage firearms:runtime held.ammo.type run tellraw @s {text:'ammo_type=legacy reserve',color:'yellow'}
tellraw @s [{text:'damage_x10='},{score:{name:'@s',objective:'fg.damage'}},{text:' delay='},{score:{name:'@s',objective:'fg.delay'}},{text:' reload='},{score:{name:'@s',objective:'fg.rticks'}},{text:' range='},{score:{name:'@s',objective:'fg.range'}},{text:' spread_mdeg='},{score:{name:'@s',objective:'fg.spread'}},{text:' pellets='},{score:{name:'@s',objective:'fg.pellets'}}]
tellraw @s [{text:'reload phase='},{score:{name:'@s',objective:'fg.rphase'}},{text:' remaining='},{score:{name:'@s',objective:'fg.reload'}},{text:' open='},{score:{name:'@s',objective:'fg.ropen'}},{text:' round='},{score:{name:'@s',objective:'fg.rticks'}},{text:' close='},{score:{name:'@s',objective:'fg.rclose'}}]
tellraw @s [{text:'eligible crit chance='},{score:{name:'@s',objective:'fg.critchance'}},{text:' bps multiplier='},{score:{name:'@s',objective:'fg.critmult'}},{text:'/1000'}]
tellraw @s [{text:'recoil pitch='},{score:{name:'@s',objective:'fg.rpitch'}},{text:'+'},{score:{name:'@s',objective:'fg.rpitchrnd'}},{text:' mdeg yaw=+/-'},{score:{name:'@s',objective:'fg.ryawrnd'}},{text:' growth='},{score:{name:'@s',objective:'fg.rgrowth'}},{text:'/1000 max_steps='},{score:{name:'@s',objective:'fg.rmax'}}]
tellraw @s [{text:'recoil reset='},{score:{name:'@s',objective:'fg.rreset'}},{text:' delay='},{score:{name:'@s',objective:'fg.rdelay'}},{text:' recovery='},{score:{name:'@s',objective:'fg.rrecover'}},{text:' mdeg/t debt='},{score:{name:'@s',objective:'fg.rdebt'}},{text:' burst='},{score:{name:'@s',objective:'fg.rburst'}}]
tellraw @s [{text:'aim enabled='},{score:{name:'@s',objective:'fg.aimenabled'}},{text:' state='},{score:{name:'@s',objective:'fg.aiming'}},{text:' ticks='},{score:{name:'@s',objective:'fg.aimticks'}},{text:'/'},{score:{name:'@s',objective:'fg.aimenter'}},{text:' spread='},{score:{name:'@s',objective:'fg.aimspread'}},{text:'/1000 recoil='},{score:{name:'@s',objective:'fg.aimrpitch'}},{text:'/'},{score:{name:'@s',objective:'fg.aimryaw'}},{text:' move='},{score:{name:'@s',objective:'fg.aimmove'}}]
tellraw @s [{text:'scope enabled='},{score:{name:'@s',objective:'fg.scenabled'}},{text:' active='},{score:{name:'@s',objective:'fg.scopen'}},{text:' ready='},{score:{name:'@s',objective:'fg.scopeready'}},{text:' ticks='},{score:{name:'@s',objective:'fg.scopeticks'}},{text:'/'},{score:{name:'@s',objective:'fg.scenter'}},{text:' spread='},{score:{name:'@s',objective:'fg.scspread'}},{text:'/1000 recoil='},{score:{name:'@s',objective:'fg.scrpitch'}},{text:'/'},{score:{name:'@s',objective:'fg.scryaw'}}]
execute unless data storage firearms:runtime {held:{visual:{tracer:0b}}} if score @s fg.tracemode matches 0 run tellraw @s [{text:'tracer=subtle start_steps=',color:'white'},{score:{name:'@s',objective:'fg.tracestart'},color:'aqua'},{text:' spacing_steps=',color:'white'},{score:{name:'@s',objective:'fg.tracegap'},color:'aqua'},{text:' (每步 0.25 格)',color:'gray'}]
execute unless data storage firearms:runtime {held:{visual:{tracer:0b}}} if score @s fg.tracemode matches 1 run tellraw @s [{text:'tracer=debug start_steps=',color:'yellow'},{score:{name:'@s',objective:'fg.tracestart'},color:'aqua'},{text:' spacing_steps=',color:'white'},{score:{name:'@s',objective:'fg.tracegap'},color:'aqua'}]
execute if data storage firearms:runtime {held:{visual:{tracer:0b}}} run tellraw @s {text:'tracer=off',color:'gray'}
execute if score @s fg.lastzone matches 0 run tellraw @s {text:'last hit: none',color:'dark_gray'}
execute if score @s fg.lastzone matches 1 run tellraw @s {text:'last hit: body (no critical roll)',color:'gray'}
execute if score @s fg.lastzone matches 2 run tellraw @s [{text:'last hit: head roll=',color:'gold'},{score:{name:'@s',objective:'fg.lastroll'}},{text:' chance='},{score:{name:'@s',objective:'fg.lastchance'}},{text:' critical='},{score:{name:'@s',objective:'fg.lastcrit'}}]
execute if score @s fg.lastzone matches 3 run tellraw @s [{text:'last hit: weakpoint roll=',color:'light_purple'},{score:{name:'@s',objective:'fg.lastroll'}},{text:' chance='},{score:{name:'@s',objective:'fg.lastchance'}},{text:' critical='},{score:{name:'@s',objective:'fg.lastcrit'}}]
